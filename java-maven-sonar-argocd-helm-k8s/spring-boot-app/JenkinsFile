pipeline {

    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        // ==========================================
        // 1. CHECKOUT
        // ==========================================

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'

                // If your Jenkins job is already configured with Git,
                // Jenkins will automatically checkout the repository.

                sh '''
                    echo "Workspace:"
                    pwd

                    echo "Files:"
                    ls -ltr
                '''
            }
        }


        // ==========================================
        // 2. BUILD AND TEST
        // ==========================================

        stage('Build and Test') {
            steps {
                sh '''
                    echo "Java version:"
                    java -version

                    echo "Maven version:"
                    mvn -version

                    echo "Building application..."

                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                    mvn clean package
                '''
            }
        }


        // ==========================================
        // 3. SONARQUBE - DISABLED
        // ==========================================

        /*
        stage('Static Code Analysis') {

            environment {
                SONAR_URL = "http://35.168.36.92:9000"
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.token=$SONAR_AUTH_TOKEN \
                            -Dsonar.host.url=$SONAR_URL
                    '''
                }
            }
        }
        */


        // ==========================================
        // 4. DOCKER BUILD AND PUSH
        // ==========================================

        stage('Build and Push Docker Image') {

            environment {
                DOCKER_IMAGE = "gowthamdocker44/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {

                script {

                    sh '''
                        echo "Installing Docker CLI..."

                        apt-get update

                        apt-get install -y docker.io

                        echo "Docker version:"
                        docker version

                        echo "Docker info:"
                        docker info

                        echo "Building Docker image..."

                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        docker build -t ${DOCKER_IMAGE} .

                        echo "Docker image created:"
                        docker images | grep ultimate-cicd
                    '''

                    echo "Pushing Docker image..."

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        dockerImage.push()
                    }

                    echo "Docker image pushed successfully:"
                    echo "${DOCKER_IMAGE}"
                }
            }
        }


        // ==========================================
        // 5. TEST GITHUB TOKEN
        // ==========================================

        stage('Test GitHub Authentication') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "Testing GitHub authentication..."

                        curl -sS \
                            -u "${GITHUB_USER}:${GITHUB_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            https://api.github.com/user \
                            | grep -E '"login"'
                    '''
                }
            }
        }


        // ==========================================
        // 6. UPDATE KUBERNETES DEPLOYMENT
        // ==========================================

        stage('Update Deployment File') {

            environment {
                GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
                GIT_USER_NAME = "gowthamselvaraj44"
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "Configuring Git..."

                        git config user.email "gowthamselvaraj44@gmail.com"
                        git config user.name "gowthamselvaraj44"

                        echo "Current Git status:"
                        git status

                        echo "Updating deployment image tag..."

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                        java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "Checking modified file..."

                        git diff

                        echo "Adding deployment file..."

                        git add \
                        java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "Creating commit..."

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}" \
                            || echo "Nothing to commit"

                        echo "Pushing changes to GitHub..."

                        git push \
                            https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main
                    '''
                }
            }
        }
    }


    // ==========================================
    // POST ACTIONS
    // ==========================================

    post {

        success {
            echo '''
            ==========================================
            PIPELINE SUCCESS
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            PIPELINE FAILED
            ==========================================
            Check the Jenkins console output.
            ==========================================
            '''
        }

        always {
            echo "Jenkins Build Number: ${BUILD_NUMBER}"
        }
    }
}
